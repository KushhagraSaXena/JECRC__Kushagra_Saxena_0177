@model List<FoodOrdering.Domain.Models.CartItem>

<div class="container mt-4">

    <h2 class="mb-4">
        Shopping Cart
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            Cart is empty
        </div>
    }
    else
    {
        <table class="table table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <img src="~/images/food/@item.ImageUrl"
                             width="100"
                             height="80"
                             style="object-fit:cover;"
                             class="rounded" />
                        </td>

                        <td>
                            @item.Name
                        </td>

                        <td>
                            ₹ @item.Price
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            ₹ @(item.Price * item.Quantity)
                        </td>

                        <td>

                            <a asp-action="Remove"
                               asp-route-id="@item.FoodItemId"
                               class="btn btn-danger btn-sm">

                                Remove

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <h4 class="text-end mt-3">

            Grand Total:
            ₹ @Model.Sum(x => x.Price * x.Quantity)

        </h4>

        <div class="text-end mt-3">

            <a asp-action="Checkout"
               class="btn btn-success">

                Checkout

            </a>

        </div>
    }

</div>