@model ProductManagement.DTOs.ProductResponseDto

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <hr />

            <h3>Are you sure you want to delete this?</h3>

            <dl class="row">
                <dt class="col-sm-2">Product ID</dt>
                <dd class="col-sm-10">@Model.Id</dd>

                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@Model.Name</dd>

                <dt class="col-sm-2">Price</dt>
                <dd class="col-sm-10">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-2">Category</dt>
                <dd class="col-sm-10">@Model.CategoryName</dd>

                <dt class="col-sm-2">Description</dt>
                <dd class="col-sm-10">@Model.Description</dd>

                <dt class="col-sm-2">Tags</dt>
                <dd class="col-sm-10">
                    @if (Model.TagIds != null && Model.TagIds.Any())
                    {
                        @string.Join(", ", Model.TagIds)
                    }
                    else
                    {
                        <span>No tags</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</div>
