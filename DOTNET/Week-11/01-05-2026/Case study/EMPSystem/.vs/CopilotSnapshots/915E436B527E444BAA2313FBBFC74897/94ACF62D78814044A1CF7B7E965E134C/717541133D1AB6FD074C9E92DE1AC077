version: '3.8'

services:
  empsystem:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: empsystem-app
    ports:
      - "8080:80"
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://0.0.0.0:80
      - ConnectionStrings__DefaultConnection=Data Source=/app/data/emp_system.db
    volumes:
      - empsystem-data:/app/data
    networks:
      - empsystem-network

volumes:
  empsystem-data:
    driver: local

networks:
  empsystem-network:
    driver: bridge
