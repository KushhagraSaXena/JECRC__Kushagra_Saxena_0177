@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center py-5">
                    <h1 class="display-4 fw-bold mb-3">
                        <span style="color: #4CAF50;">📊</span> Employee Management System
                    </h1>
                    <p class="lead mb-4">
                        A modern microservice architecture for managing your employee database with Docker containerization.
                    </p>
                    <hr class="my-4">
                    <p class="text-muted">Built with ASP.NET Core 9 | Razor Pages | Docker Microservices</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 style="color: #2196F3;">👥 Manage Employees</h3>
                    <p class="card-text">View, create, edit, and delete employee records efficiently.</p>
                    <a href="/Employee" class="btn btn-primary">View Employees</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 style="color: #FF9800;">🏗️ Microservices</h3>
                    <p class="card-text">MVC Container → API Container → SQL Container working seamlessly.</p>
                    <small class="text-muted">Docker Network: localhost:8082</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 style="color: #9C27B0;">🔒 Secure & Reliable</h3>
                    <p class="card-text">Built on modern .NET 9 with enterprise-grade architecture.</p>
                    <small class="text-muted">ASP.NET Core MVC</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="alert alert-info border-0 shadow-sm">
                <h5 class="alert-heading">🚀 Getting Started</h5>
                <p class="mb-0">Click on the "Employees" link in the navigation bar to start managing your employee database. The application is connected to an API container which fetches data from SQL Server running in Docker.</p>
            </div>
        </div>
    </div>
</div>
